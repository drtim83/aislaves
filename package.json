{
  "name": "aislaves",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @aislaves/web run dev",
    "build": "npm --workspace @aislaves/web run build",
    "start": "npm --workspace @aislaves/web run start",
    "test": "npx tsx --test packages/crew-engine/src/__tests__/engine.test.ts",
    "seed:demo": "npx tsx packages/demo-sandbox/src/seed.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
