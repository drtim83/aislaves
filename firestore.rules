        (!('mimeType' in data) || isBoundedString(data.mimeType, 1, 120)) &&
        (!('fileSizeBytes' in data) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 52428800)) &&
        (!('uploadedByUid' in data) || isBoundedString(data.uploadedByUid, 1, 128)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidKnowledgeChunk(data, chunkId, orgId, colId) {
      return data.keys().hasAll(['id', 'tenantId', 'collectionId', 'chunkIndex', 'content', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'tenantId', 'collectionId', 'chunkIndex', 'content',
          'sectionRef', 'pageNumber', 'departmentScope',
          'embeddingModel', 'embedding', 'createdAt'
        ]) &&
        isBoundedString(data.id, 1, 80) && data.id == chunkId &&
        isBoundedString(data.tenantId, 1, 64) && data.tenantId == orgId &&
        isBoundedString(data.collectionId, 1, 64) && data.collectionId == colId &&
        data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 100000 &&
        isBoundedString(data.content, 1, 16000) &&
        (!('sectionRef' in data) || isBoundedString(data.sectionRef, 0, 200)) &&
        (!('pageNumber' in data) || (data.pageNumber is int && data.pageNumber >= 1 && data.pageNumber <= 10000)) &&
        (!('departmentScope' in data) || data.departmentScope in ['public_sales', 'all_staff', 'finance_only', 'hr_confidential']) &&
        (!('embeddingModel' in data) || isBoundedString(data.embeddingModel, 1, 80)) &&
        (!('embedding' in data) || (isValidList(data.embedding, 4096) && (data.embedding.size() == 0 || (data.embedding[0] is number && data.embedding[data.embedding.size() - 1] is number)))) &&
        data.createdAt is timestamp;
    }

    function isValidSharedWorkbook(data, workbookId, orgId) {
      return data.keys().hasAll(['id', 'tenantId', 'fileName', 'lastUpdatedAt']) &&
        data.keys().hasOnly([
          'id', 'tenantId', 'fileName', 'provider', 'folderPath', 'storagePath',
          'preservedFormulas', 'backups', 'committedRows', 'stagingRows',
          'lockedColumns', 'leaseLockedBy', 'leaseExpiresAt',
          'uploadedByUid', 'createdAt', 'lastUpdatedAt'
        ]) &&
        isBoundedString(data.id, 1, 64) && data.id == workbookId &&
        isBoundedString(data.tenantId, 1, 64) && data.tenantId == orgId &&
        isBoundedString(data.fileName, 1, 200) &&
        (!('provider' in data) || data.provider in ['local_exceljs', 'gdrive_sheets', 'onedrive_excel', 'smb_local_folder', 'dropbox_upload']) &&
        (!('folderPath' in data) || isBoundedString(data.folderPath, 0, 400)) &&
        (!('storagePath' in data) || isTenantScopedStoragePath(data.storagePath, orgId)) &&
        (!('preservedFormulas' in data) || isBoundedStringList(data.preservedFormulas, 30, 200)) &&
        (!('backups' in data) || (isValidList(data.backups, 50) && (data.backups.size() == 0 || data.backups[0] is map))) &&
        (!('committedRows' in data) || (isValidList(data.committedRows, 500) && (data.committedRows.size() == 0 || data.committedRows[0] is map))) &&
        (!('stagingRows' in data) || (isValidList(data.stagingRows, 500) && (data.stagingRows.size() == 0 || data.stagingRows[0] is map))) &&
        (!('lockedColumns' in data) || isBoundedStringList(data.lockedColumns, 30, 80)) &&
        (!('leaseLockedBy' in data) || isBoundedString(data.leaseLockedBy, 0, 128)) &&
        (!('leaseExpiresAt' in data) || data.leaseExpiresAt is timestamp) &&
        (!('uploadedByUid' in data) || isBoundedString(data.uploadedByUid, 1, 128)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.lastUpdatedAt is timestamp;
    }

    function isValidLead(data, leadId, orgId) {
      return data.keys().hasAll(['id', 'tenantId', 'fullName', 'company', 'source', 'ocrConfidence', 'stage', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'tenantId', 'fullName', 'jobTitle', 'company', 'email', 'phone',
          'source', 'ocrConfidence', 'stage', 'dedupeHash', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isBoundedString(data.id, 1, 64) && data.id == leadId &&
        isBoundedString(data.tenantId, 1, 64) && data.tenantId == orgId &&
        isBoundedString(data.fullName, 1, 120) &&
        (!('jobTitle' in data) || isBoundedString(data.jobTitle, 0, 120)) &&
        isBoundedString(data.company, 1, 160) &&
        (!('email' in data) || isValidEmail(data.email)) &&
        (!('phone' in data) || isBoundedString(data.phone, 0, 40)) &&
        data.source in ['whatsapp_card_ocr', 'batch_expo_ocr', 'inbound_webhook', 'manual_operator'] &&
        data.ocrConfidence is number && data.ocrConfidence >= 0 && data.ocrConfidence <= 1 &&
        data.stage in ['new_lead', 'awaiting_approval', 'outreach_active', 'replied_positive', 'meeting_booked', 'archived'] &&
        (!('dedupeHash' in data) || isBoundedString(data.dedupeHash, 1, 128)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 2000)) &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidApproval(data, approvalId, orgId) {
      return data.keys().hasAll([
          'id', 'tenantId', 'runId', 'idempotencyKey', 'actionType',
          'title', 'summary', 'channel', 'status', 'createdAt', 'payload'
        ]) &&
        data.keys().hasOnly([
          'id', 'tenantId', 'runId', 'idempotencyKey', 'actionType',
          'title', 'summary', 'channel', 'status', 'createdAt',
          'decidedAt', 'decidedBy', 'decisionNote', 'payload'
        ]) &&
        isBoundedString(data.id, 1, 64) && data.id == approvalId &&
        isBoundedString(data.tenantId, 1, 64) && data.tenantId == orgId &&
        isBoundedString(data.runId, 1, 64) &&
        isBoundedString(data.idempotencyKey, 8, 128) &&
        data.actionType in ['outbound_email_send', 'calendar_booking_confirm', 'excel_commit_update', 'expense_claim_payout'] &&
        isBoundedString(data.title, 1, 200) &&
        isBoundedString(data.summary, 1, 2000) &&
        data.channel in ['whatsapp', 'portal'] &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        (!('decidedAt' in data) || data.decidedAt is timestamp) &&
        (!('decidedBy' in data) || isBoundedString(data.decidedBy, 1, 128)) &&
        (!('decisionNote' in data) || isBoundedString(data.decisionNote, 0, 1000)) &&
        isBoundedMap(data.payload, 30);
    }

    function isValidAuditLog(data, auditId, orgId) {
      return data.keys().hasAll(['id', 'tenantId', 'actor', 'event', 'detail', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'tenantId', 'actor', 'actorUid', 'event',
          'detail', 'runId', 'approvalId', 'timestamp'
        ]) &&
        isBoundedString(data.id, 1, 64) && data.id == auditId &&
        isBoundedString(data.tenantId, 1, 64) && data.tenantId == orgId &&
        isBoundedString(data.actor, 1, 120) &&
        (!('actorUid' in data) || isBoundedString(data.actorUid, 1, 128)) &&
        isBoundedString(data.event, 1, 120) &&
        isBoundedString(data.detail, 1, 4000) &&
        (!('runId' in data) || isBoundedString(data.runId, 1, 64)) &&
        (!('approvalId' in data) || isBoundedString(data.approvalId, 1, 64)) &&
        data.timestamp is timestamp;
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // 1. Agency Operators (Operator Builder & Fleet Studio)
    match /platform_operators/{uid} {
      allow get: if isAuthenticated() && (isOwner(uid) || isOperator());
      allow list: if isOperator();
      allow create: if isOperatorAdmin() && isValidPlatformOperator(request.resource.data, uid);
      allow update: if isOperatorAdmin() &&
        isValidPlatformOperator(request.resource.data, uid) &&
        areImmutableFieldsUnchanged(['createdAt']) &&
        isOptionalImmutableFieldUnchanged('uid');
      allow delete: if isOperatorAdmin() && uid != request.auth.uid;
    }

    // 2. Interactive Live Sales Demo Templates (Operator-only)
    match /demo_templates/{demoId} {
      allow read: if isOperator();
      allow create: if isOperator() && isValidDemoTemplate(request.resource.data, demoId);
      allow update: if isOperator() &&
        isValidDemoTemplate(request.resource.data, demoId) &&
        areImmutableFieldsUnchanged(['id', 'isDemo', 'createdAt']);
      allow delete: if isOperator();
    }

    // 3. Multi-Tenant SME Workspaces (Non-self-service; Operator provisioned)
    match /tenants/{orgId} {
      allow read: if isOperator() || isTenantMember(orgId);
      allow create: if isOperator() && isValidTenant(request.resource.data, orgId);
      allow update: if isOperator() &&
        isValidTenant(request.resource.data, orgId) &&
        areImmutableFieldsUnchanged(['id', 'isDemo', 'createdAt']);
      allow delete: if isOperator();

      // 4.1 Tenant Subscription & Billing Caps (Operator writes only)
      match /subscription/{docId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidSubscription(request.resource.data);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidSubscription(request.resource.data) &&
          isOptionalImmutableFieldUnchanged('createdAt');
        allow delete: if isOperator();
      }

      // 4.2 SME Portal Members (Operator or Tenant Owner managing non-owner staff)
      match /members/{uid} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isValidMember(request.resource.data) && (
          (isOperator() && tenantExistsOrCreatedAfter(orgId)) ||
          (isTenantOwner(orgId) &&
            uid != request.auth.uid &&
            request.resource.data.role != 'owner' &&
            'updatedAt' in request.resource.data &&
            isRecent(request.resource.data.updatedAt))
        );
        allow update: if isValidMember(request.resource.data) && (
          (isOperator() && tenantExists(orgId)) ||
          (isTenantOwner(orgId) &&
            uid != request.auth.uid &&
            resource.data.role != 'owner' &&
            request.resource.data.role != 'owner' &&
            'updatedAt' in request.resource.data &&
            isRecent(request.resource.data.updatedAt))
        );
        allow delete: if isOperator() ||
          (isTenantOwner(orgId) && uid != request.auth.uid && resource.data.role != 'owner');
      }

      // 4.3 Time-Limited 1-Tap Magic Connect Links (No member list; narrow redemption)
      match /magic_links/{tokenId} {
        allow get: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow list: if isOperator() && tenantExists(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidMagicLink(request.resource.data, orgId) &&
          (request.resource.data.status != 'pending' || request.resource.data.expiresAt > request.time);
        allow update: if isValidMagicLink(request.resource.data, orgId) && (
          (isOperator() &&
            tenantExists(orgId) &&
            areImmutableFieldsUnchanged(['token', 'tenantId', 'createdAt'])) ||
          (isTenantMember(orgId) &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'completed' &&
            request.time < resource.data.expiresAt &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'completedAt', 'completedByUid'
            ]) &&
            'completedAt' in request.resource.data &&
            isRecent(request.resource.data.completedAt) &&
            'completedByUid' in request.resource.data &&
            request.resource.data.completedByUid == request.auth.uid)
        );
        allow delete: if isOperator();
      }

      // 4.4 Operator-Only Connector Bindings, Custom APIs & MCP Servers (Secret protection)
      match /cartridges/{cartridgeId} {
        allow read: if isOperator() && tenantExists(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidCartridge(request.resource.data);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidCartridge(request.resource.data) &&
          isOptionalImmutableFieldUnchanged('createdAt');
        allow delete: if isOperator();
      }

      match /custom_apis/{apiId} {
        allow read: if isOperator() && tenantExists(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidCustomApi(request.resource.data, apiId, orgId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidCustomApi(request.resource.data, apiId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'tenantId', 'createdAt']);
        allow delete: if isOperator();
      }

      match /mcp_servers/{serverId} {
        allow read: if isOperator() && tenantExists(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidMcpServer(request.resource.data, serverId, orgId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidMcpServer(request.resource.data, serverId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'createdAt']) &&
          isOptionalImmutableFieldUnchanged('tenantId');
        allow delete: if isOperator();
      }

      // 4.5 Tenant-Readable, Operator-Managed Workforce & Execution Traces
      match /role_templates/{templateId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidRoleTemplate(request.resource.data, templateId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidRoleTemplate(request.resource.data, templateId) &&
          areImmutableFieldsUnchanged(['id', 'createdAt']);
        allow delete: if isOperator();
      }

      match /hired_agents/{employeeId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidHiredAgent(request.resource.data, employeeId, orgId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidHiredAgent(request.resource.data, employeeId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'orgId', 'createdAt']);
        allow delete: if isOperator();
      }

      match /hired_crews/{crewId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidHiredCrew(request.resource.data, crewId, orgId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidHiredCrew(request.resource.data, crewId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'orgId', 'createdAt']);
        allow delete: if isOperator();
      }

      match /outreach_sequences/{seqId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidOutreachSequence(request.resource.data, seqId, orgId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidOutreachSequence(request.resource.data, seqId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'tenantId']) &&
          isOptionalImmutableFieldUnchanged('createdAt');
        allow delete: if isOperator();
      }

      match /runs/{runId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidCrewRun(request.resource.data, runId, orgId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidCrewRun(request.resource.data, runId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'tenantId', 'startedAt']);
        allow delete: if isOperator();

        match /steps/{stepId} {
          allow read: if (
            (isOperator() && tenantExists(orgId)) || isTenantMember(orgId)
          ) && exists(/databases/$(database)/documents/tenants/$(orgId)/runs/$(runId));
          allow create: if isOperator() &&
            tenantExistsOrCreatedAfter(orgId) &&
            existsAfter(/databases/$(database)/documents/tenants/$(orgId)/runs/$(runId)) &&
            isValidRunStep(request.resource.data, stepId);
          allow update: if isOperator() &&
            tenantExists(orgId) &&
            exists(/databases/$(database)/documents/tenants/$(orgId)/runs/$(runId)) &&
            isValidRunStep(request.resource.data, stepId) &&
            isOptionalImmutableFieldUnchanged('id') &&
            isOptionalImmutableFieldUnchanged('createdAt');
          allow delete: if isOperator();
        }
      }

      // 4.6 Knowledge Drop-Box, Indexed Chunks, Shared Workbooks & Leads
      match /knowledge_collections/{colId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isValidKnowledgeCollection(request.resource.data, colId, orgId) && (
          (isOperator() && tenantExistsOrCreatedAfter(orgId)) ||
          (isTenantManagerOrOwner(orgId) &&
            request.resource.data.indexed == false &&
            (!('citationsCount' in request.resource.data) || request.resource.data.citationsCount == 0) &&
            'uploadedByUid' in request.resource.data &&
            request.resource.data.uploadedByUid == request.auth.uid &&
            (!('createdAt' in request.resource.data) || isRecent(request.resource.data.createdAt)) &&
            isRecent(request.resource.data.updatedAt))
        );
        allow update: if isValidKnowledgeCollection(request.resource.data, colId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'tenantId']) &&
          isOptionalImmutableFieldUnchanged('createdAt') &&
          isOptionalImmutableFieldUnchanged('uploadedByUid') && (
            (isOperator() && tenantExists(orgId)) ||
            (isTenantManagerOrOwner(orgId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'docName', 'summary', 'excerptSample', 'departmentScope',
                'storagePath', 'mimeType', 'fileSizeBytes', 'updatedAt'
              ]) &&
              isRecent(request.resource.data.updatedAt))
          );
        allow delete: if isOperator() || isTenantManagerOrOwner(orgId);

        // Vector/SOP chunks are server/Admin SDK or operator-managed ONLY
        match /chunks/{chunkId} {
          allow read: if (
            (isOperator() && tenantExists(orgId)) || isTenantMember(orgId)
          ) && exists(/databases/$(database)/documents/tenants/$(orgId)/knowledge_collections/$(colId));
          allow create: if isOperator() &&
            tenantExistsOrCreatedAfter(orgId) &&
            existsAfter(/databases/$(database)/documents/tenants/$(orgId)/knowledge_collections/$(colId)) &&
            isValidKnowledgeChunk(request.resource.data, chunkId, orgId, colId);
          allow update: if isOperator() &&
            tenantExists(orgId) &&
            exists(/databases/$(database)/documents/tenants/$(orgId)/knowledge_collections/$(colId)) &&
            isValidKnowledgeChunk(request.resource.data, chunkId, orgId, colId) &&
            areImmutableFieldsUnchanged(['id', 'tenantId', 'collectionId', 'createdAt']);
          allow delete: if isOperator();
        }
      }

      match /shared_workbooks/{workbookId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isValidSharedWorkbook(request.resource.data, workbookId, orgId) && (
          (isOperator() && tenantExistsOrCreatedAfter(orgId)) ||
          (isTenantManagerOrOwner(orgId) &&
            request.resource.data.keys().hasOnly([
              'id', 'tenantId', 'fileName', 'provider', 'folderPath',
              'storagePath', 'uploadedByUid', 'createdAt', 'lastUpdatedAt'
            ]) &&
            'uploadedByUid' in request.resource.data &&
            request.resource.data.uploadedByUid == request.auth.uid &&
            (!('createdAt' in request.resource.data) || isRecent(request.resource.data.createdAt)) &&
            isRecent(request.resource.data.lastUpdatedAt))
        );
        allow update: if isValidSharedWorkbook(request.resource.data, workbookId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'tenantId']) &&
          isOptionalImmutableFieldUnchanged('createdAt') &&
          isOptionalImmutableFieldUnchanged('uploadedByUid') && (
            (isOperator() && tenantExists(orgId)) ||
            (isTenantManagerOrOwner(orgId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'fileName', 'provider', 'folderPath', 'storagePath', 'lastUpdatedAt'
              ]) &&
              isRecent(request.resource.data.lastUpdatedAt))
          );
        allow delete: if isOperator() || isTenantManagerOrOwner(orgId);
      }

      match /leads/{leadId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidLead(request.resource.data, leadId, orgId);
        allow update: if isOperator() &&
          tenantExists(orgId) &&
          isValidLead(request.resource.data, leadId, orgId) &&
          areImmutableFieldsUnchanged(['id', 'tenantId', 'createdAt']);
        allow delete: if isOperator();
      }

      // 4.7 Approval Inbox (1-Tap Approve/Reject with Idempotency & Immutability)
      match /approvals/{approvalId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidApproval(request.resource.data, approvalId, orgId);
        allow update: if isValidApproval(request.resource.data, approvalId, orgId) &&
          areImmutableFieldsUnchanged([
            'id', 'tenantId', 'runId', 'idempotencyKey',
            'actionType', 'createdAt', 'payload'
          ]) && (
            (isOperator() && tenantExists(orgId)) ||
            (isTenantApprover(orgId) &&
              resource.data.status == 'pending' &&
              request.resource.data.status in ['approved', 'rejected'] &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'decidedBy', 'decidedAt', 'decisionNote'
              ]) &&
              'decidedBy' in request.resource.data &&
              request.resource.data.decidedBy == request.auth.uid &&
              'decidedAt' in request.resource.data &&
              isRecent(request.resource.data.decidedAt))
          );
        allow delete: if isOperator();
      }

      // 4.8 Append-Only Immutable Compliance Audit Ledger
      match /audit_logs/{auditId} {
        allow read: if (isOperator() && tenantExists(orgId)) || isTenantMember(orgId);
        allow create: if isOperator() &&
          tenantExistsOrCreatedAfter(orgId) &&
          isValidAuditLog(request.resource.data, auditId, orgId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // 5. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
