# AISlaves Environment Variables
# Copy to apps/web/.env.local when running locally with live Gemini, Firebase, Email, or WhatsApp Cloud APIs.

# Optional: Enable live Gemini 2.5 Flash/Pro OCR, RAG embeddings & drafting
GEMINI_API_KEY=

# Operator Bootstrap Email (first operator signing in via Firebase Auth gets Admin role)
INITIAL_OPERATOR_EMAIL=timothy.tok@gmail.com

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (JSON string or base64 encoded JSON for server-side Firestore persistence & Auth verification)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Real Outreach Mailer (optional: Resend HTTP API or SMTP via Nodemailer)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Real Meta WhatsApp Business Cloud API Webhook (optional)
WHATSAPP_VERIFY_TOKEN=aislaves-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Stripe FPX / DuitNow / Cards (optional)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
